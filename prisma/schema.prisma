generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskType {
  coding
  summarization
  reasoning
  support
}

enum EvalMode {
  mock
  live_openai
}

enum ScoreSource {
  heuristic
  llm_judge
}

enum PolicyAction {
  allow
  block
  downgrade
  escalate
}

enum RequestCategory {
  work_coding
  work_support
  work_summary
  business_reasoning
  personal
  sensitive
  unknown
}

model ModelProfile {
  id                String       @id
  name              String
  provider          String
  contextWindow     Int
  inputCostPerMTok  Float
  outputCostPerMTok Float
  medianLatencyMs   Int
  qualityScore      Int
  taskScores         Json
  strengths         String[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  evalResults       EvalResult[]

  @@index([provider])
}

model PromptCase {
  id             String       @id
  dataset        String
  title          String
  taskType       TaskType
  difficulty     Int
  inputTokens    Int
  expectedOutput String
  prompt         String
  rubric         Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  evalResults    EvalResult[]
  policyDecisions PolicyDecision[]

  @@index([dataset])
  @@index([taskType])
}

model Team {
  id               String           @id
  name             String
  monthlyBudgetUsd Float
  currentSpendUsd  Float
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  users            AppUser[]
  policyDecisions  PolicyDecision[]
}

model AppUser {
  id              String           @id
  name            String
  email           String           @unique
  role            String
  teamId          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  policyDecisions PolicyDecision[]

  @@index([teamId])
}

model EvalRun {
  id             String           @id @default(cuid())
  promptId       String
  mode           EvalMode         @default(mock)
  weights        Json
  createdAt      DateTime         @default(now())
  results        EvalResult[]
  routerDecision RouterDecision?

  @@index([promptId])
  @@index([createdAt])
}

model EvalResult {
  id           String       @id @default(cuid())
  evalRunId    String
  modelId      String
  promptId     String
  output       String
  score        Int
  scoreSource  ScoreSource  @default(heuristic)
  judgeModelId String?
  judgeExplanation String?
  judgedAt     DateTime?
  latencyMs    Int
  inputTokens  Int
  outputTokens Int
  totalCostUsd Float
  rubricScores Json
  createdAt    DateTime     @default(now())
  evalRun      EvalRun      @relation(fields: [evalRunId], references: [id], onDelete: Cascade)
  model        ModelProfile @relation(fields: [modelId], references: [id])
  prompt       PromptCase   @relation(fields: [promptId], references: [id])

  @@index([evalRunId])
  @@index([modelId])
  @@index([promptId])
}

model RouterDecision {
  id          String   @id @default(cuid())
  evalRunId   String   @unique
  modelId     String
  routerScore Int
  reasons     String[]
  createdAt   DateTime @default(now())
  evalRun     EvalRun  @relation(fields: [evalRunId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

model PolicyDecision {
  id                         String          @id @default(cuid())
  promptId                   String
  userId                     String
  teamId                     String
  requestedModelId           String
  selectedModelId            String?
  action                     PolicyAction
  category                   RequestCategory
  complexityScore            Int
  workRelated                Boolean
  estimatedRequestedCostUsd  Float
  estimatedRoutedCostUsd     Float
  savingsUsd                 Float
  budgetRemainingUsd         Float
  reasons                    String[]
  createdAt                  DateTime        @default(now())
  prompt                     PromptCase      @relation(fields: [promptId], references: [id])
  user                       AppUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([userId])
  @@index([teamId])
  @@index([action])
  @@index([createdAt])
}
